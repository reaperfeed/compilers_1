i32 main()
{
    i32[10] arr;

    i32 i = 0;
    while (i < 10)
    {
        arr[i] = i * i;
        i += 1;
    }

    i32 sum = 0;
    i32 k = 0;
    for (k = 0; k < 10; k += 1)
    {
        sum += arr[k];
    }

    prints("array content: ");
    i32 m = 0;
    while (m < 10)
    {
        printi(arr[m]);
        prints(" ");
        m += 1;
    }
    prints("\n");

    prints("sum of squares 0..9 = ");
    printi(sum);
    prints("\n");

    return 0;
}