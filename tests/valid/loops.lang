i32 main()
{
    i32 sum = 0;
    i32 i = 1;
    while (i <= 10)
    {
        sum += i;
        i += 1;
    }
    prints("sum 1..10 = ");
    printi(sum);
    prints("\n");

    i32 fact = 1;
    i32 j = 1;
    for (j = 1; j <= 5; j += 1)
    {
        fact *= j;
    }
    prints("5! = ");
    printi(fact);
    prints("\n");

    i32 x = 42;
    if (x < 0)
    {
        prints("negative\n");
    }
    elif (x == 0)
    {
        prints("zero\n");
    }
    else
    {
        prints("positive\n");
    }

    return 0;
}